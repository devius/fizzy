<section class="settings__section">
  <% transfer = user.identity.transfer %>

  <header>
    <h2 class="divider"><%= t(".heading") %></h2>
    <p class="margin-none" id="session_transfer_label"><%= t(".description") %></p>
  </header>

  <% if transfer %>
    <% url = session_transfer_url(transfer.token, script_name: nil) %>

    <input type="text" class="input fill-white" id="session_transfer_url" value="<%= url %>" aria-labelledby="session_transfer_label" readonly>

    <div class="flex justify-center gap">
      <div data-controller="dialog" data-dialog-modal-value="true" class="flex-inline">
        <%= tag.button class: "btn", data: { action: "dialog#open", controller: "tooltip" } do %>
          <%= icon_tag "qr-code" %>
          <span class="for-screen-reader"><%= t(".display_qr") %></span>
        <% end %>

        <dialog class="dialog panel shadow" data-dialog-target="dialog" style="--panel-size: 50ch;">
          <p class="margin-none-block-start txt-balance">
            <strong><%= t(".scan_to_login") %></strong>
          </p>

          <%= qr_code_image(url) %>

          <form method="dialog" class="margin-block-start flex justify-center">
            <button class="btn">
              <span><%= t(".done") %></span>
            </button>
          </form>
        </dialog>
      </div>

      <%= button_to_copy_to_clipboard(url) do %>
        <%= icon_tag "copy-paste" %>
        <span class="for-screen-reader"><%= t(".copy_link") %></span>
      <% end %>

      <%= button_to transfer_token_path, method: :post, class: "btn", data: { controller: "tooltip" } do %>
        <%= icon_tag "refresh" %>
        <span class="for-screen-reader"><%= t(".regenerate_link") %></span>
      <% end %>
    </div>
  <% else %>
    <div class="flex justify-center">
      <%= button_to transfer_token_path, method: :post, class: "btn" do %>
        <%= icon_tag "refresh" %>
        <span><%= t(".regenerate_link") %></span>
      <% end %>
    </div>
  <% end %>
</section>
