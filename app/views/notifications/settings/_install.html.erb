<% unless (platform.chrome? && !platform.ios?) || (platform.firefox? && !platform.android?) %>
  <div class="notifications-help pwa__instructions hide-in-pwa">
    <h3><%= platform.safari? && platform.desktop? ? t(".or_install") : t(".install") %></h3>
    <% case
      when platform.edge? %>
        <ol>
          <li><%= t(".edge.step1_html", icon: icon_tag("install-edge", alt: t(".install_button"))) %></li>
          <li><%= t(".edge.step2_html") %></li>
        </ol>
      <% when platform.chrome? && platform.android? %>
        <ol>
          <li><%= t(".chrome_android.step1_html", icon: icon_tag("menu-dots-vertical", alt: t(".more_options"))) %></li>
          <li><%= t(".chrome_android.step2_html") %></li>
        </ol>
      <% when platform.firefox? && platform.android? %>
        <ol>
          <li><%= t(".firefox_android.step1_html", icon: icon_tag("menu-dots-vertical", alt: t(".more_options"))) %></li>
          <li><%= t(".firefox_android.step2_html") %></li>
        </ol>
      <% when platform.safari? && platform.desktop? %>
        <ol>
          <li><%= t(".safari_desktop.step1_html") %></li>
          <li><%= t(".safari_desktop.step2_html") %></li>
        </ol>
      <% when (platform.safari? || platform.chrome?) && platform.ios? %>
        <p><%= t(".ios_intro", browser: platform.browser.capitalize, os: platform.operating_system) %></p>
        <ol>
          <li><%= t(".ios.step1_html", icon: icon_tag("share", alt: t(".share_button"))) %></li>
          <li><%= t(".ios.step2_html") %></li>
        </ol>
      <% else %>
        <p><%= t(".fallback") %></p>
    <% end %>
  </div>
<% end %>
