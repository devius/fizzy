<div class="notifications-help hide-in-browser" data-notifications-target="details">
  <h3><%= t(".heading", os: platform.operating_system) %></h3>
  <% case
    when platform.firefox? && platform.android? %>
      <ol>
        <li><%= t(".firefox_android.step1_html", icon: icon_tag("menu-dots-vertical.svg", alt: t(".more_options"))) %></li>
        <li><%= t(".firefox_android.step2_html") %></li>
        <li><%= t(".firefox_android.step3_html") %></li>
        <li><%= t(".firefox_android.step4_html", icon: icon_tag("switch", alt: t(".the_toggle_button")), browser: platform.browser.capitalize) %></li>
      </ol>
    <% when platform.edge? && platform.desktop? %>
      <ol>
        <li><%= t(".windows.step1_html") %></li>
        <li><%= t(".windows.step2_html") %></li>
        <li><%= t(".windows.step3_fizzy_html", icon: icon_tag("switch", alt: t(".the_toggle_button"))) %></li>
      </ol>
    <% when (platform.firefox? || platform.chrome?) && platform.desktop? %>
      <ol>
        <% if platform.windows? %>
          <li><%= t(".windows.step1_html") %></li>
          <li><%= t(".windows.step2_html") %></li>
          <li><%= t(".windows.step3_fizzy_html", icon: icon_tag("switch", alt: t(".the_toggle_button"))) %></li>
        <% else %>
          <li><%= t(".mac.step1_html") %></li>
          <li><%= t(".mac.step2_html") %></li>
          <li><%= t(".mac.step3_html") %></li>
          <li><%= t(".mac.step4_fizzy_html") %></li>
          <li><%= t(".mac.step5_html", icon: icon_tag("switch", alt: t(".allow_switch"))) %></li>
        <% end %>
      </ol>
    <% when platform.safari? && platform.desktop? %>
      <ol>
        <li><%= t(".mac.step1_html") %></li>
        <li><%= t(".mac.step2_html") %></li>
        <li><%= t(".mac.step3_html") %></li>
        <li><%= t(".mac.step4_fizzy_html") %></li>
        <li><%= t(".mac.step5_html", icon: icon_tag("switch", alt: t(".allow_switch"))) %></li>
      </ol>
    <% when (platform.safari? || platform.chrome?) && platform.ios? %>
      <ol>
        <li><%= t(".ios.step1_html", icon: icon_tag("gear", aria: { hidden: "true" })) %></li>
        <li><%= t(".ios.step2_html") %></li>
        <li><%= t(".ios.step3_html") %></li>
        <li><%= t(".ios.step4_html", icon: icon_tag("switch", alt: t(".allow_switch_button"))) %></li>
      </ol>
    <% when platform.chrome? && platform.android? %>
      <ol>
        <li><%= t(".chrome_android.step1_html", icon: icon_tag("gear", aria: { hidden: "true" })) %></li>
        <li><%= t(".chrome_android.step2_html") %></li>
        <li><%= t(".chrome_android.step3_html") %></li>
        <li><%= t(".chrome_android.step4_html") %></li>
        <li><%= t(".chrome_android.step5_html", icon: icon_tag("switch", alt: t(".the_switch"))) %></li>
      </ol>
    <% else %>
      <p><%= t(".fallback", browser: platform.browser.capitalize) %></p>
  <% end %>
</div>
