<% unless (platform.safari? || platform.chrome?) && platform.ios? %>
  <div class="notifications-help" data-notifications-target="details">
    <% case
      when platform.firefox? && platform.android? %>
        <h3><%= t(".turn_on_browser", browser: platform.browser.capitalize) %></h3>
        <ol>
          <li><%= t(".firefox_android.step1_html", icon: icon_tag("lock", alt: t(".view_site_info"))) %></li>
          <li><%= t(".firefox_android.step2_html") %></li>
        </ol>
      <% when platform.edge? && platform.desktop? %>
        <h3><%= t(".turn_on_website") %></h3>
        <ol>
          <li><%= t(".edge_desktop.step1_html", icon: icon_tag("lock", alt: t(".view_site_info"))) %></li>
          <li><%= t(".edge_desktop.step2_html") %></li>
        </ol>
        <h3><%= t(".turn_on_browser", browser: platform.browser.capitalize) %></h3>
        <ol>
          <% if platform.windows? %>
            <li><%= t(".windows.step1_html") %></li>
            <li><%= t(".windows.step2_html") %></li>
            <li><%= t(".windows.step3_html", icon: icon_tag("switch", alt: t(".the_switch")), browser: platform.browser.capitalize) %></li>
          <% else %>
            <li><%= t(".mac.step1_html") %></li>
            <li><%= t(".mac.step2_html") %></li>
            <li><%= t(".mac.step3_html") %></li>
            <li><%= t(".mac.step4_html", browser: platform.browser.capitalize) %></li>
            <li><%= t(".mac.step5_html", icon: icon_tag("switch", alt: t(".the_switch"))) %></li>
          <% end %>
        </ol>
      <% when platform.firefox? && platform.desktop? %>
        <h3><%= t(".turn_on_website") %></h3>
        <ol>
          <li><%= t(".firefox_desktop.step1_html", browser: platform.browser.capitalize) %></li>
          <li><%= t(".firefox_desktop.step2_html") %></li>
          <li><%= t(".firefox_desktop.step3_html") %></li>
          <li><%= t(".firefox_desktop.step4_html") %></li>
          <li><%= t(".firefox_desktop.step5_html") %></li>
          <li><%= t(".firefox_desktop.step6_html", url: root_url) %></li>
        </ol>

        <h3><%= t(".turn_on_browser", browser: platform.browser.capitalize) %></h3>
        <ol>
          <% if platform.windows? %>
            <li><%= t(".windows.step1_html") %></li>
            <li><%= t(".windows.step2_html") %></li>
            <li><%= t(".windows.step3_html", icon: icon_tag("switch", alt: t(".the_toggle_button")), browser: platform.browser.capitalize) %></li>
          <% else %>
            <li><%= t(".mac.step1_html") %></li>
            <li><%= t(".mac.step2_html") %></li>
            <li><%= t(".mac.step3_html") %></li>
            <li><%= t(".mac.step4_html", browser: platform.browser.capitalize) %></li>
            <li><%= t(".mac.step5_html", icon: icon_tag("switch", alt: t(".the_switch"))) %></li>
          <% end %>
        </ol>
      <% when platform.chrome? && platform.desktop? %>
        <h3><%= t(".turn_on_website") %></h3>
        <ol>
          <li><%= t(".chrome_desktop.step1_html", icon: icon_tag("sliders", alt: t(".view_site_info"))) %></li>
          <li><%= t(".chrome_desktop.step2_html") %></li>
          <li><%= t(".chrome_desktop.step3_html") %></li>
        </ol>

        <h3><%= t(".turn_on_browser", browser: platform.browser.capitalize) %></h3>
        <ol>
          <% if platform.windows? %>
            <li><%= t(".windows.step1_html") %></li>
            <li><%= t(".windows.step2_html") %></li>
            <li><%= t(".windows.step3_html", icon: icon_tag("switch", alt: t(".the_switch")), browser: platform.browser.capitalize) %></li>
          <% else %>
            <li><%= t(".mac.step1_html") %></li>
            <li><%= t(".mac.step2_html") %></li>
            <li><%= t(".mac.step3_html") %></li>
            <li><%= t(".mac.step4_html", browser: platform.browser == "Chrome" ? "Google Chrome" : platform.browser.capitalize) %></li>
            <li><%= t(".mac.step5_html", icon: icon_tag("switch", alt: t(".the_switch"))) %></li>
          <% end %>
        </ol>
      <% when platform.chrome? && platform.android? %>
        <h3><%= t(".turn_on_browser", browser: platform.browser.capitalize) %></h3>
        <ol>
          <li><%= t(".chrome_android.step1_html", icon: icon_tag("menu-dots-vertical", alt: t(".more_options"))) %></li>
          <li><%= t(".chrome_android.step2_html") %></li>
          <li><%= t(".chrome_android.step3_html") %></li>
          <li><%= t(".chrome_android.step4_html", icon: icon_tag("switch", alt: t(".the_switch")), browser: platform.browser.capitalize) %></li>
          <li><%= t(".chrome_android.step5_html", icon: icon_tag("switch", alt: t(".the_switch"))) %></li>
          <li><%= t(".chrome_android.step6_html", icon: icon_tag("bell-alert", alt: t(".the_notification_bell"))) %></li>
        </ol>
      <% when platform.safari? && platform.desktop? %>
        <h3><%= t(".turn_on_website") %></h3>
        <ol>
          <li><%= t(".mac.step1_html") %></li>
          <li><%= t(".mac.step2_html") %></li>
          <li><%= t(".mac.step3_html") %></li>
          <li><%= t(".safari_desktop_website.step4_html", url: request.base_url) %></li>
          <li><%= t(".mac.step5_html", icon: icon_tag("switch", alt: t(".the_switch"))) %></li>
        </ol>
        <h3><%= t(".turn_on_browser", browser: platform.browser.capitalize) %></h3>
        <ol>
          <li><%= t(".safari_desktop_browser.step1_html", browser: platform.browser.capitalize) %></li>
          <li><%= t(".safari_desktop_browser.step2_html") %></li>
          <li><%= t(".safari_desktop_browser.step3_html") %></li>
          <li><%= t(".safari_desktop_browser.step4_html") %></li>
          <li><%= t(".safari_desktop_browser.step5_html", url: request.base_url) %></li>
          <li><%= t(".safari_desktop_browser.step6_html") %></li>
        </ol>
      <% else %>
        <p><%= t(".fallback_html", url: root_url) %></p>
    <% end %>
  </div>
<% end %>
