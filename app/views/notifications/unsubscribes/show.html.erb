<div class="panel margin-block-double center shadow">
  <h1 class="font-black txt-x-large margin-none-block-end"><%= t(".heading") %></h1>
  <p class="margin-block-start-half"><%= t(".thanks_html", name: @user.first_name, link: link_to(t(".notification_settings"), notifications_settings_path)) %></p>

  <%= link_to root_path, class: "btn btn--link margin-block-start" do %>
    <%= icon_tag "arrow-left" %>
    <span><%= t(".back_to_fizzy") %></span>
  <% end %>
</div>
