<p class="subtitle"><%= t(".subtitle") %></p>

<% if @import.failed_due_to_conflict? %>
  <p><%= t(".conflict") %></p>
<% elsif @import.failed_due_to_invalid_export? %>
  <p><%= t(".invalid_export") %></p>
<% else %>
  <p><%= t(".unknown") %></p>
<% end %>

<p class="footer"><%= t(".help_html", email: mail_to("support@fizzy.do", t(".send_us_an_email"))) %></p>
