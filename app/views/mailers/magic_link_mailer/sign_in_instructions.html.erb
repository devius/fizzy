
<% if @magic_link.for_sign_in? %>
  <h1 class="title"><%= t(".sign_in.title") %></h1>
  <p class="subtitle"><%= t(".sign_in.subtitle") %></p>
<% else %>
  <h1 class="title"><%= t(".sign_up.title") %></h1>
  <p class="subtitle"><%= t(".sign_up.subtitle") %></p>
<% end %>

<strong class="txt-large"><%= @magic_link.code %></strong>

<p><%= t(".code_validity", time: distance_of_time_in_words(MagicLink::EXPIRATION_TIME)) %></p>

<% if account = @magic_link.identity.accounts.last %>
  <p><%= t(".passkey_html", passkey_link: link_to(t(".passkey_word"), my_passkeys_url(script_name: account.slug))) %></p>
<% end %>

<p class="footer"><%= t(".help_html", email: mail_to("support@fizzy.do", t(".send_us_an_email"))) %>.
</p>

