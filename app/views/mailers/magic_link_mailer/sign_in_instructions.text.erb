<% if @magic_link.for_sign_in? %>
<%= t(".sign_in.subtitle") %>
<% else %>
<%= t(".sign_up.subtitle") %>
<% end %>

<%= @magic_link.code %>

<%= t(".code_validity", time: distance_of_time_in_words(MagicLink::EXPIRATION_TIME)) %>

<% if account = @magic_link.identity.accounts.last %>
<%= t(".passkey_text", url: my_passkeys_url(script_name: account.slug)) %>
<% end %>
